# Required IMAP account settings
IMAP_HOST=mail.example.com
IMAP_USER=you@example.com
IMAP_PASSWORD=replace-with-a-secret

# Transport security: SSL/TLS is the default. Set only one of IMAP_SSL or
# IMAP_STARTTLS to true. Plaintext is rejected unless explicitly opted into.
IMAP_SSL=true
IMAP_STARTTLS=false
# IMAP_ALLOW_INSECURE=false
# IMAP_PORT=993
IMAP_TIMEOUT_SECONDS=30

# Only these exact folders can be accessed. Do not leave this blank.
IMAP_ALLOWED_FOLDERS=Labels/Receipts

# Runtime limits
MAX_BODY_CHARS=50000
LOG_LEVEL=INFO

# MCP HTTP endpoint. Generate a token with: openssl rand -base64 32
MCP_BEARER_TOKEN=replace-with-a-long-random-secret
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
